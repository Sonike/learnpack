          "id": "py-quiz-split-empty",
          "type": "quiz",
          "question": "What is `\"a,b,,c\".split(\",\")`?",
          "options": [
            "`[\"a\", \"b\", \"c\"]`",
            "`[\"a\", \"b\", \"\", \"c\"]`",
            "`[\"a\", \"b\", \",\", \"c\"]`",
            "`[\"a,b,,c\"]`"
